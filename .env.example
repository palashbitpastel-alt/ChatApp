# Environment Variables
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection String
# On Railway, this is provided automatically when you attach a PostgreSQL plugin.
# For local dev: postgresql://USER:PASSWORD@localhost:5432/chatapp?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp?schema=public"

# JWT Secret for Session Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-chatapp"

# Next.js Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
